// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
    // output        = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
}

model User {
    id        String   @id
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    // secret
    token String

    userName    String
    displayName String

    avatar          String?
    isDiscordAvatar Boolean   @default(false)
    uploadedAt      DateTime?

    isMasc Boolean @default(false)
    isFem  Boolean @default(false)
    isEnby Boolean @default(false)

    hasFinishedSetup Boolean @default(false)

    allowSetupOverride  Boolean @default(false)
    allowSignupOverride Boolean @default(false)
    allowVotingOverride Boolean @default(false)

    votesCasted   Vote[] @relation("castedVotes")
    votesReceived Vote[] @relation("receivedVotes")

    @@unique(userName)
    @@unique(token)
}

model Vote {
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    targetId String
    sourceId String

    vote         String
    time         Int?
    timesChanged Int    @default(0)

    target User @relation(fields: [targetId], references: [id], onDelete: Cascade, name: "receivedVotes")
    source User @relation(fields: [sourceId], references: [id], onDelete: Cascade, name: "castedVotes")

    @@id([sourceId, targetId])
}
